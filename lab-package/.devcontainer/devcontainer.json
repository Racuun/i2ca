{
  "name": "i2ca RISC-V Laboratory",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "student",
  "customizations": {
    "vscode": {
      "extensions": [
        "dan-c-underwood.riscv",
        "ms-vscode.cpptools",
        "ms-python.python",
        "mshr-h.VerilogHDL"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.associations": {
          "*.dig": "xml",
          "*.s": "riscv"
        }
      }
    }
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  }
}
